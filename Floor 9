local function getRequire()
    if type(require) == "function" then return require end
    if type(getgenv) == "function" and type(getgenv().require) == "function" then return getgenv().require end
    if type(getrenv) == "function" then
        local env = getrenv()
        if type(env.require) == "function" then return env.require end
        if type(env._G) == "table" and type(env._G.require) == "function" then return env._G.require end
    end
    return nil
end

local function findModuleScript(name)
    local services = { game:GetService("ReplicatedStorage"), Players.LocalPlayer:FindFirstChild("PlayerScripts") }
    for _, srv in ipairs(services) do
        if srv then
            local found = srv:FindFirstChild(name, true)
            if found and found:IsA("ModuleScript") then return found end
        end
    end
    return nil
end

local function hollowModule(name)
    local key = "Hollow module: " .. name
    if App.modules[key] then return App.modules[key] end
    local req = getRequire()
    if not req then return nil, "Require not available" end
    local ok, result = pcall(function() return req(name) end)
    if not ok or type(result) ~= "table" then
        local inst = findModuleScript(name)
        if inst then
            local ok2, res2 = pcall(function() return req(inst) end)
            if ok2 and type(res2) == "table" then
                App.modules[key] = res2
                return res2
            end
        end
        return nil, tostring(result)
    end
    if type(result) == "table" then App.modules[key] = result; return result end
    return nil, "Invalid module"
end

local function character()
    local model = Player.Character
    local root = model and model:FindFirstChild("HumanoidRootPart")
    local humanoid = model and model:FindFirstChildOfClass("Humanoid")
    if root and humanoid and humanoid.Health > 0 then return model, root, humanoid end
end

local function positionOf(o)
    if not o then return end
    if o:IsA("BasePart") then return o.Position end
    if o:IsA("Model") then return o:GetPivot().Position end
end

local function nearest(tag, pred)
    local _, root = character()
    local found, dist
    for _, o in ipairs(Collection:GetTagged(tag)) do
        if o:IsDescendantOf(workspace) and (not pred or pred(o)) then
            local p = positionOf(o)
            local l = p and root and (p - root.Position).Magnitude or math.huge
            if p and (not found or l < dist) then found, dist = o, l end
        end
    end
    return found, dist
end

local function getPart(object)
    if not object or not object.Parent then return nil end
    if object:IsA("BasePart") then return object end
    if object:IsA("Attachment") then return getPart(object.Parent) end
    if object:IsA("Model") and object.PrimaryPart then return object.PrimaryPart end
    return object:FindFirstChildWhichIsA("BasePart", true)
end

local function getPoint(object)
    if not object then return nil end
    if object:IsA("Attachment") then return object.WorldPosition end
    local part = getPart(object)
    return part and part.Position or nil
end

local function getNearest(items)
    local _, root = character()
    if not root then return nil end
    local best, dist = nil, math.huge
    for _, item in ipairs(items) do
        local point = getPoint(item.part)
        if point then
            local d = (point - root.Position).Magnitude
            if d < dist then
                best, dist = item, d
            end
        end
    end
    return best
end

local function active() return App.alive and App.running end

local function waitUntil(cb, seconds)
    local deadline = os.clock() + (seconds or 10)
    repeat
        if not active() then return nil end
        local ok, v = pcall(cb)
        if ok and v then return v end
        task.wait(0.1)
    until os.clock() >= deadline
    return nil
end

local function pause(seconds)
    local finish = os.clock() + seconds
    repeat
        if not active() then return false end
        task.wait(math.min(0.1, math.max(0, finish - os.clock())))
    until os.clock() >= finish
    return active()
end

local function call(key, cb, seconds)
    if not active() then return false, "Stopped" end
    local request = { done = false }
    task.spawn(function() request.result = table.pack(pcall(cb)); request.done = true end)
    local deadline = os.clock() + (seconds or 8)
    repeat
        if not active() then return false, "Stopped" end
        if request.done then return table.unpack(request.result, 1, request.result.n) end
        task.wait(0.05)
    until os.clock() >= deadline
    return false, "Timed out"
end

local function approach(position, ignore)
    local model, root, humanoid = character()
    if not model then return false end
    if typeof(position) ~= "Vector3" or position.Y <= workspace.FallenPartsDestroyHeight + 32 then return false end
    pcall(function() Player:RequestStreamAroundAsync(position, 1) end)
    task.wait(0.5)
    if not active() or Player.Character ~= model then return false end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local excluded = { model }
    if ignore then table.insert(excluded, ignore) end
    params.FilterDescendantsInstances = excluded
    params.RespectCanCollide = true
    local hit = workspace:Raycast(position + Vector3.new(0, 8, 0), Vector3.new(0, -40, 0), params)
    if not hit or hit.Normal.Y < 0.6 then return false end
    local candidate = hit.Position + Vector3.new(0, math.max(2.6, humanoid.HipHeight + root.Size.Y / 2), 0)
    root.AssemblyLinearVelocity, root.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
    local target = CFrame.new(candidate) * root.CFrame.Rotation
    model:PivotTo(target * root.CFrame:ToObjectSpace(model:GetPivot()))
    return pause(0.45)
end

local function forceTeleport(target)
    local model, root = character()
    if not model or not root then return false end
    if typeof(target) ~= "Vector3" then return false end
    
    local dest = target + Vector3.new(0, 3, 0)
    local targetCF = CFrame.new(dest) * root.CFrame.Rotation
    
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
    model:PivotTo(targetCF)
    root.CFrame = targetCF
    
    return true
end

local function rideElevator(part, clientState, objects, floor)
    local kind = floor and "MazeElevatorEntrance" or "MazeElevatorExit"
    local ok, controller = call(part, function() return objects.getObjectAsync(kind, part) end, 8)
    if not ok or type(controller) ~= "table" or type(controller.enterElevator) ~= "function" then return false end
    local moved = approach(part.Position)
    if not moved then return false end
    local rider = waitUntil(function() return clientState.getState("CurrentCharacter") end, 4)
    if rider and not controller.riding and not clientState.getState("PromptElevator") and not clientState.isLocked("CharacterBusyState") then
        call("Elevator", function() controller.enterElevator(rider) end, 5)
    end
    local selected = false
    local arrived = waitUntil(function()
        if floor and clientState.getState("PromptElevator") and not selected then
            selected = true
            pcall(function() clientState.setState("ElevatorSelection", floor) end)
        end
        local maze = Player:GetAttribute("InMaze")
        return (floor and maze and maze ~= false and tonumber(maze) == floor) or ((not floor) and (not maze))
    end, 30)
    if not arrived then return false end
    return waitUntil(function() return not clientState.isLocked("CharacterBusyState") end, 12) ~= nil
end

local function solveLevers()
    local puzzle, why = hollowModule("LeverWallsPuzzle")
    if not puzzle then return false, "LeverWallsPuzzle failed to load: " .. tostring(why) end
    
    local objects = hollowModule("OOPTags")
    if not objects then return false, "OOPTags failed to load" end
    
    local deadline, retryAt = os.clock() + 300, 0
    
    while active() and os.clock() < deadline do
        if Player:GetAttribute("HasRelic") == true then return true end
        
        local state = puzzle.getState()
        
        if type(state) == "table" and type(state.Walls) == "table" and type(state.Levers) == "table" and type(state.Opened) == "number" then
            local expected = state.Walls[state.Opened + 1]
            local items = {}
            
            for _, object in ipairs(Collection:GetTagged(expected and "%WallLever" or "%LeverWallsRelic")) do
                local part = getPart(object)
                local key = object:GetAttribute(tostring(Player.UserId))
                local symbol = key ~= nil and (state.Levers[tostring(key)] or state.Levers[key])
                if part and (not expected or tostring(symbol) == tostring(expected)) then
                    table.insert(items, {
                        object = object,
                        part = part,
                        key = key,
                        title = expected and "Next lever: " .. tostring(expected) or "Take rune",
                    })
                end
            end
            
            local item = getNearest(items)
            
            if state.Solved then
                notify("Waiting for the rune...")
            elseif item and os.clock() >= retryAt then
                local opened = state.Opened
                notify(item.title)
                local kind = expected and "WallLever" or "LeverWallsRelic"
                
                local point = getPoint(item.part)
                if point then 
                    forceTeleport(point) 
                    task.wait(0.2) 
                end
                
                local ok, native = call("Floor 9 " .. kind, function()
                    return objects.getObjectAsync(kind, item.object)
                end, 4)
                
                local live = puzzle.getState()
                
                if ok and native and active() and live == state and live.Opened == opened and not live.Solved then
                    local promptPoint = getPoint(native.prompt and native.prompt.Parent or item.part)
                    if promptPoint then 
                        forceTeleport(promptPoint) 
                        task.wait(0.15)
                    end
                    
                    local valid = not expected or (type(native.icon) == "function" and tostring(native:icon()) == tostring(expected))
                    
                    if valid then
                        notify("Auto PP: Firing...")
                        
                        call("Floor 9 action", function()
                            if expected then
                                puzzle.pull(native)
                            else
                                puzzle.claim(native)
                            end
                        end, 4)
                        
                        local prompt = item.part:FindFirstChildWhichIsA("ProximityPrompt", true) 
                                    or item.object:FindFirstChildWhichIsA("ProximityPrompt", true)
                                    or (native and native.prompt)
                        
                        if prompt then
                            pcall(function()
                                if type(fireproximityprompt) == "function" then
                                    fireproximityprompt(prompt)
                                else
                                    prompt.InputHoldBegin(prompt)
                                    task.wait(prompt.HoldDuration + 0.1)
                                    prompt.InputHoldEnd(prompt)
                                end
                            end)
                        end
                    else
                        notify("Icon mismatch. Expected: " .. tostring(expected))
                    end
                end
                
                waitUntil(function()
                    local latest = puzzle.getState()
                    return Player:GetAttribute("HasRelic") == true
                        or latest ~= state
                        or (latest and (latest.Opened ~= opened or latest.Solved))
                end, 5)
                
                retryAt = os.clock() + 1.5
                
            elseif not item then
                notify("Target missing: " .. tostring(expected) .. ". Streaming room...")
                local allLevers = Collection:GetTagged(expected and "%WallLever" or "%LeverWallsRelic")
                local closestLever = nil
                local _, root = character()
                
                if root then
                    local minDist = math.huge
                    for _, obj in ipairs(allLevers) do
                        local p = getPart(obj)
                        if p then
                            local d = (p.Position - root.Position).Magnitude
                            if d < minDist then
                                minDist = d
                                closestLever = p
                            end
                        end
                    end
                end
                
                if closestLever then
                    forceTeleport(closestLever.Position)
                else
                    local frame = Collection:GetTagged("%RiddleFrame")[1]
                    if frame then forceTeleport(getPoint(frame)) end
                end
                retryAt = os.clock() + 2
            else
                notify("Waiting for cooldown...")
            end
        else
            notify("Waiting for puzzle state to load...")
        end
        
        if not pause(0.3) then break end
    end
    return false, active() and "The lever room hasn't advanced" or "Stopped"
end

local function runFloor9()
    notify("Starting Floor 9 Auto Puzzle...")
    local clientState = hollowModule("ClientState")
    local objects = hollowModule("OOPTags")
    if not clientState or not objects then 
        notify("Modules failed to load.")
        App.running = false
        return 
    end

    local maze = Player:GetAttribute("InMaze")
    if tonumber(maze) ~= 9 then
        notify("Not on Floor 9. Finding elevator...")
        local entrance = nearest("%MazeElevatorEntrance")
        if entrance then
            local ok = rideElevator(entrance, clientState, objects, 9)
            if not ok then 
                notify("Failed to ride elevator.")
                App.running = false
                return 
            end
            notify("Arrived on Floor 9!")
        else
            notify("Elevator not found. Are you in the lobby?")
            App.running = false
            return
        end
    end

    if not pause(2) then return end

    local ok, why = solveLevers()
    
    if ok then
        notify("Puzzle solved! Waiting for relic...")
        local gotRelic = waitUntil(function() return Player:GetAttribute("HasRelic") == true end, 15)
        if gotRelic then
            notify("Relic obtained! Heading to exit...")
            pause(3)
            local exit = nearest("%MazeElevatorExit")
            if exit then
                if rideElevator(exit, clientState, objects) then
                    notify("Successfully returned to lobby!")
                else
                    notify("Failed to return via elevator.")
                end
            else
                notify("Exit elevator not found.")
            end
        end
    else
        notify("Stopped: " .. tostring(why or "Unknown error"), 8)
    end
    App.running = false
end

