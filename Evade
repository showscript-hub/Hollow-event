        setStatus("Not found", 0)
        notify("No skull path found")
    end
end)

TabMain:CreateButton("TP Every Skull", function()
    tpAllSkulls()
end)

TabMain:CreateButton("Stop Skull TP", function()
    skullTpRunning = false
    setStatus("Stopping", lastFoundCount)
    notify("Stopping...")
end)

task.defer(function()
    local parts = collectSkullParts()
    if parts then
        setStatus("Ready", #parts)
    else
        setStatus("Not found", 0)
    end
end)
