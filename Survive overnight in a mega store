-- INFINITE JUMP
local jumpConnection

local function setupInfiniteJump()
    if jumpConnection then
        jumpConnection:Disconnect()
    end

    jumpConnection = UserInputService.JumpRequest:Connect(function()
        if not infJumpEnabled then return end

        local character = LocalPlayer.Character
        if not character then return end

        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if not humanoid or humanoid.Health <= 0 then return end

        humanoid.Jump = true
        humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
    end)
end

setupInfiniteJump()

TabMain:CreateToggle("INF Jump", false, function(state)
    infJumpEnabled = state
    notify("INF Jump: " .. (state and "ON" or "OFF"))
end)

-- TELEPORT
local function teleportTo(cf)
    local character = LocalPlayer.Character
    if not character then return end

    local root = character:FindFirstChild("HumanoidRootPart")

    if root and cf then
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        root.CFrame = cf
    end
end

-- PROMPTS
local function triggerPromptsInObject(object)
    for _, descendant in ipairs(object:GetDescendants()) do
        if descendant:IsA("ProximityPrompt") then
            pcall(function()
                if type(fireproximityprompt) == "function" then
                    fireproximityprompt(descendant)
                end
            end)
        end
    end
end

-- CAULDRON
local function tpCauldron()
    local map = Workspace:FindFirstChild("Map")
    local util = map and map:FindFirstChild("Util")
    local cauldron = util and util:FindFirstChild("Cauldron")
    local model = cauldron and cauldron:FindFirstChild("Model")
    local visual = model and model:FindFirstChild("_CauldronVisual")

    if not visual then
        return notify("Cauldron not found!")
    end

    local targetPart

    if visual:IsA("BasePart") then
        targetPart = visual
    elseif visual:IsA("Model") then
        targetPart = visual.PrimaryPart or visual:FindFirstChildWhichIsA("BasePart", true)
    end

    if targetPart then
        teleportTo(targetPart.CFrame + Vector3.new(0, 3, 0))
        notify("Teleported to Cauldron!")
    else
        notify("Cauldron part not found!")
    end
end

-- PUMPKIN CHESTS
local function refreshChestQueue()
    local map = Workspace:FindFirstChild("Map")
    local util = map and map:FindFirstChild("Util")
    local pumpkinChests = util and util:FindFirstChild("PumpkinChests")

    if not pumpkinChests then
        return false
    end

    chestQueue = {}

    for _, obj in ipairs(pumpkinChests:GetChildren()) do
        if obj:IsA("Model") then
            table.insert(chestQueue, obj)
        end
    end

    currentChestIndex = 1

    if #chestQueue == 0 then
        return false
    end

    notify("Loaded " .. #chestQueue .. " Pumpkin Chests.")
    return true
end

local function tpNextPumpkinChest()
    if currentChestIndex > #chestQueue or #chestQueue == 0 then
        if not refreshChestQueue() then
            return notify("Pumpkin Chests not found!")
        end
    end

    local chest = chestQueue[currentChestIndex]

    if not chest or not chest.Parent then
        currentChestIndex += 1
        return tpNextPumpkinChest()
    end

    local targetPart = chest.PrimaryPart or chest:FindFirstChildWhichIsA("BasePart", true)
    local targetCFrame = targetPart and targetPart.CFrame or chest:GetPivot()

    teleportTo(targetCFrame + Vector3.new(0, 3, 0))

    task.wait(0.2)
    triggerPromptsInObject(chest)

    notify(string.format(
        "[%d/%d] Teleported to: %s",
        currentChestIndex,
        #chestQueue,
        chest.Name
    ))

    currentChestIndex += 1
end

-- BUTTONS
TabMain:CreateButton("TP Pumpkin Chest", function()
    tpNextPumpkinChest()
end)

TabMain:CreateButton("TP Cauldron", function()
    tpCauldron()
end)
