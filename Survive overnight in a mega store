local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/reallycoolusername101-cmyk/Nil_Library/refs/heads/main/wizard"))()
local Window = Library:NewWindow("The Hollow - Mega Store")
local TabMain = Window:NewSection("Main")
local TabInfo = Window:NewSection("Info")

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local UserInputService = game:GetService("UserInputService")
local StarterGui = game:GetService("StarterGui")
local LocalPlayer = Players.LocalPlayer

local chestQueue = {}
local currentChestIndex = 1
local infJumpEnabled = false

local function notify(text, duration)
    pcall(function()
        StarterGui:SetCore("SendNotification", { Title = "Mega Store Script", Text = tostring(text), Duration = duration or 4 })
    end)
    print("[Mega Store] " .. tostring(text))
end

TabInfo:CreateButton("Credit: CatHub", function() notify("Script by CatHub") end)
TabInfo:CreateButton("Copy Discord Invite", function()
    local copy = setclipboard or toclipboard
    if type(copy) == "function" then
        copy("discord.gg/FJK6QzNnf7")
        notify("Discord link copied to clipboard!")
    else
        notify("Executor doesn't support clipboard.")
    end
end)

local function getHumanoid()
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    return char:WaitForChild("Humanoid")
end

UserInputService.JumpRequest:Connect(function()
    if not infJumpEnabled then return end
    local humanoid = getHumanoid()
    if humanoid and humanoid.Health > 0 then
        humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
    end
end)

local function teleportTo(cf)
    local character = LocalPlayer.Character
    if character then
        local root = character:FindFirstChild("HumanoidRootPart")
        if root and cf then
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            root.CFrame = cf
        end
    end
end

local function triggerPromptsInObject(object)
    for _, descendant in ipairs(object:GetDescendants()) do
        if descendant:IsA("ProximityPrompt") then
            pcall(function()
                descendant.HoldDuration = 0
                descendant.MaxActivationDistance = 32
                if type(fireproximityprompt) == "function" then
                    fireproximityprompt(descendant)
                else
                    descendant.InputHoldBegin(descendant)
                    task.wait(0.1)
                    descendant.InputHoldEnd(descendant)
                end
            end)
        end
    end
end

local function tpCauldron()
    local map = Workspace:FindFirstChild("Map")
    if not map then return notify("Map not found!") end

    local util = map:FindFirstChild("Util")
    if not util then return notify("Util not found!") end

    local cauldron = util:FindFirstChild("Cauldron")
    if not cauldron then return notify("Cauldron not found!") end

    local model = cauldron:FindFirstChild("Model")
    if not model then return notify("Cauldron Model not found!") end

    local cauldronVisual = model:FindFirstChild("_CauldronVisual")
    if cauldronVisual then
        local targetPart = nil
        if cauldronVisual:IsA("BasePart") then
            targetPart = cauldronVisual
        elseif cauldronVisual:IsA("Model") then
            targetPart = cauldronVisual.PrimaryPart or cauldronVisual:FindFirstChildWhichIsA("BasePart", true)
        end

        if targetPart then
            teleportTo(targetPart.CFrame + Vector3.new(0, 3, 0))
            notify("Teleported to Cauldron!")
        end
    else
        notify("_CauldronVisual not found!")
    end
end

local function refreshChestQueue()
    local map = Workspace:FindFirstChild("Map")
    if not map then return false end

    local util = map:FindFirstChild("Util")
    if not util then return false end

    local pumpkinChests = util:FindFirstChild("PumpkinChests")
    if not pumpkinChests then return false end

    chestQueue = {}
    for _, obj in ipairs(pumpkinChests:GetChildren()) do
        if obj:IsA("Model") then
            table.insert(chestQueue, obj)
        end
    end

    if #chestQueue == 0 then return false end

    currentChestIndex = 1
    notify("Loaded " .. tostring(#chestQueue) .. " Pumpkin Chests.")
    return true
end

local function tpNextPumpkinChest()
    if #chestQueue == 0 or currentChestIndex > #chestQueue then
        local success = refreshChestQueue()
        if not success then
            notify("Pumpkin Chests not found!")
            return
        end
    end

    local currentChest = chestQueue[currentChestIndex]

    if currentChest and currentChest.Parent then
        local targetPart = currentChest.PrimaryPart or currentChest:FindFirstChildWhichIsA("BasePart", true)
        local targetCFrame = targetPart and targetPart.CFrame or currentChest:GetPivot()

        if targetCFrame then
            teleportTo(targetCFrame + Vector3.new(0, 3, 0))
            task.wait(0.2)

            triggerPromptsInObject(currentChest)
            if currentChest.Parent then
                triggerPromptsInObject(currentChest.Parent)
            end

            notify(string.format("[%d/%d] Teleported to: %s", currentChestIndex, #chestQueue, currentChest.Name))
            currentChestIndex = currentChestIndex + 1
        else
            currentChestIndex = currentChestIndex + 1
            tpNextPumpkinChest()
        end
    else
        currentChestIndex = currentChestIndex + 1
        tpNextPumpkinChest()
    end
end

TabMain:CreateToggle("INF Jump", false, function(state)
    infJumpEnabled = state
    notify("INF Jump: " .. (state and "ON" or "OFF"))
end)

TabMain:CreateButton("TP Pumpkin Chest", function()
    tpNextPumpkinChest()
end)

TabMain:CreateButton("TP Cauldron", function()
    tpCauldron()
end)
